{
  "name": "okalit-language-support",
  "displayName": "Okalit Language Support",
  "description": "Syntax highlighting for Okalit .ok files",
  "version": "0.0.4",
  "publisher": "Okalit",
  "icon": "./okalit.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:okalit"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "okalit",
        "aliases": [
          "Okalit",
          "okalit"
        ],
        "extensions": [
          ".ok"
        ],
        "icon": {
          "light": "./okalit.png",
          "dark": "./okalit.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "okalit",
        "scopeName": "source.okalit",
        "path": "./syntaxes/okalit.tmLanguage.json",
        "embeddedLanguages": {
          "source.js.embedded.okalit": "javascript",
          "meta.template.body.okalit": "html",
          "meta.section.render.okalit": "html"
        },
        "tokenTypes": {
          "meta.embedded.expression.okalit": "other"
        }
      },
      {
        "scopeName": "okalit.html-injection",
        "path": "./syntaxes/okalit-html-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "source.okalit"
        ]
      }
    ]
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.0"
  },
  "scripts": {
    "test": "node --test"
  }
}
