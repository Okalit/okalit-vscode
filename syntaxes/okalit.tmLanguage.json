{
  "scopeName": "source.okalit",
  "patterns": [
    {
      "include": "#render-section"
    },
    {
      "include": "#code-section"
    },
    {
      "include": "#role-section"
    },
    {
      "include": "source.js"
    }
  ],
  "repository": {
    "code-section": {
      "name": "meta.section.code.okalit",
      "begin": "^\\s*@(script|logic)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.okalit"
        },
        "2": {
          "name": "punctuation.section.block.begin.okalit"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.okalit"
        }
      },
      "patterns": [
        {
          "include": "#nested-brace"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "role-section": {
      "name": "meta.section.role.okalit",
      "begin": "^\\s*@(component|page|module|main)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.okalit"
        },
        "2": {
          "name": "punctuation.section.block.begin.okalit"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.okalit"
        }
      },
      "patterns": [
        {
          "include": "#nested-brace"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "render-section": {
      "name": "meta.section.render.okalit",
      "begin": "^\\s*(@render)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.okalit"
        },
        "2": {
          "name": "punctuation.section.block.begin.okalit"
        }
      },
      "end": "^\\s*(\\})\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.end.okalit"
        }
      },
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.okalit",
      "contentName": "source.js.embedded.okalit",
      "begin": "(\\$)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.js"
        },
        "2": {
          "name": "punctuation.section.embedded.begin.js"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.js"
        }
      },
      "patterns": [
        {
          "include": "#nested-brace"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "nested-brace": {
      "name": "meta.brace-group.js",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.js"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.js"
        }
      },
      "patterns": [
        {
          "include": "#nested-brace"
        },
        {
          "include": "source.js"
        }
      ]
    }
  }
}
